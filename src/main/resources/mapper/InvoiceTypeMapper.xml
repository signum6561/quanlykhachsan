<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="${ibatis.dao}.InvoiceTypeDAO">
    <resultMap id="invoiceTypeRM" type="InvoiceType">
        <id property="code" column="code" />
        <result property="name" column="name_type" />
    </resultMap>

    <select 
        id="selectAll"
        resultMap="invoiceTypeRM"
        timeout="60000"
        resultSetType="FORWARD_ONLY" 
    >
        select * from invoice_type
    </select>

    <select 
        id="selectByCode"
        resultMap="invoiceTypeRM"
        timeout="60000"
        resultSetType="FORWARD_ONLY" 
    >
        select * from invoice_type where code = #{code}
    </select>
</mapper>